<?php

/**
 * @file
 * Waukee core helpers.
 */

use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\group\Entity\GroupInterface;
use Drupal\node\NodeInterface;

/**
 * Loads one "school" group by its field_slug.
 */
function waukee_core_school_by_slug(string $slug): ?GroupInterface {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'school')
    ->condition('field_slug', $slug)
    ->range(0, 1)
    ->execute();
  return $ids ? $storage->load(reset($ids)) : NULL;
}

/**
 * Flattens a "school" group into plain values for Twig.
 */
function waukee_core_school_data(GroupInterface $group): array {
  $value = function (string $field) use ($group) {
    return $group->hasField($field) && !$group->get($field)->isEmpty() ? $group->get($field)->value : '';
  };
  $rich = function (string $field) use ($group) {
    if (!$group->hasField($field) || $group->get($field)->isEmpty()) {
      return NULL;
    }
    $item = $group->get($field)->first();
    return ['value' => $item->value, 'format' => $item->format];
  };
  return [
    'id' => $group->id(),
    'slug' => $value('field_slug'),
    'url' => $value('field_slug') ? Url::fromRoute('waukee_core.school_detail', ['school' => $value('field_slug')])->toString() : '',
    'name' => $group->label(),
    'tier' => $value('field_tier'),
    'feeder' => $value('field_feeder'),
    'grades' => $value('field_grades'),
    'mascot' => $value('field_mascot'),
    'address' => $value('field_address'),
    'phone' => $value('field_phone'),
    'attendance_phone' => $value('field_attendance_phone'),
    'principal' => $value('field_principal'),
    'principal_email' => $value('field_principal_email'),
    'summary' => $value('field_summary'),
    'badge' => $value('field_badge'),
    'enrollment' => $value('field_enrollment'),
    'image' => $value('field_photo_url'),
    'website' => $group->hasField('field_website') && !$group->get('field_website')->isEmpty() ? $group->get('field_website')->uri : '',
    'csd_unit' => $value('field_csd_unit'),
    'bell_hours' => $value('field_bell_hours'),
    'early_dismissal' => $value('field_early_dismissal'),
    'hero_tagline' => $value('field_hero_tagline'),
    'full_profile' => (bool) $value('field_full_profile'),
    'principal_message' => $rich('field_principal_message'),
    'leadership_team' => $rich('field_leadership_team'),
    'news_highlights' => $rich('field_news_highlights'),
    'family_resources' => $rich('field_family_resources'),
    'link_label' => $value('field_link_label') ?: 'Explore',
  ];
}

/**
 * All "school" groups that have a tier set, grouped by tier, for /schools.
 */
function waukee_core_schools_by_tier(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('group');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'school')
    ->exists('field_tier')
    ->sort('label')
    ->execute();
  $byTier = ['elementary' => [], 'middle' => [], 'transition' => [], 'high' => [], 'specialized' => []];
  foreach ($storage->loadMultiple($ids) as $group) {
    $data = waukee_core_school_data($group);
    if (isset($byTier[$data['tier']])) {
      $byTier[$data['tier']][] = $data;
    }
  }
  return $byTier;
}

/**
 * Implements hook_theme().
 */
function waukee_core_theme() {
  return [
    'waukee_schools' => [
      'variables' => ['schools' => []],
      'template' => 'waukee-schools',
    ],
  ];
}

/**
 * Implements hook_token_info().
 *
 * Smart Date stores timestamps, which Token cannot format. These tokens give
 * Schema.org Event markup proper ISO 8601 dates in the event's own timezone.
 */
function waukee_core_token_info() {
  return [
    'tokens' => [
      'node' => [
        'waukee-event-start' => [
          'name' => t('Event start (ISO 8601)'),
          'description' => t('Start of the first Event "When" value, e.g. 2026-11-04T19:00:00-06:00.'),
        ],
        'waukee-event-end' => [
          'name' => t('Event end (ISO 8601)'),
          'description' => t('End of the first Event "When" value.'),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function waukee_core_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];
  if ($type !== 'node' || empty($data['node']) || !$data['node']->hasField('field_when') || $data['node']->get('field_when')->isEmpty()) {
    return $replacements;
  }
  $item = $data['node']->get('field_when')->first();
  $timezone = new \DateTimeZone($item->timezone ?: date_default_timezone_get());
  foreach ($tokens as $name => $original) {
    $property = match ($name) {
      'waukee-event-start' => 'value',
      'waukee-event-end' => 'end_value',
      default => NULL,
    };
    if ($property && $item->{$property}) {
      $replacements[$original] = (new \DateTimeImmutable('@' . $item->{$property}))->setTimezone($timezone)->format('c');
    }
  }
  return $replacements;
}

/**
 * Implements hook_views_data_alter().
 */
function waukee_core_views_data_alter(array &$data) {
  $data['node_field_data']['waukee_school'] = [
    'title' => t('School (includes district-wide)'),
    'help' => t('Filter by school; items tagged "District (all schools)" match every school.'),
    'filter' => [
      'field' => 'nid',
      'id' => 'waukee_school',
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 *
 * Brand styling for the content add/edit forms (admin theme).
 */
function waukee_core_page_attachments(array &$attachments) {
  $route = \Drupal::routeMatch()->getRouteName();
  if (in_array($route, ['node.add', 'entity.node.edit_form', 'entity.group_relationship.create_form', 'entity.group_relationship.edit_form'], TRUE)) {
    $attachments['#attached']['library'][] = 'waukee_core/admin_forms';
  }
}

/**
 * Implements hook_node_grants().
 *
 * With a node-grants module active (Permissions by Term), core's "published or
 * can see unpublished" check in admin lists is skipped and unpublished nodes
 * only appear when a grant allows it. These grants let reviewers (permission
 * "view any unpublished content") see every unpublished node, and authors
 * ("view own unpublished content") see their own, in /admin/content and
 * /admin/content/moderated.
 */
function waukee_core_node_grants(AccountInterface $account, $op) {
  $grants = [];
  if ($op === 'view') {
    if ($account->hasPermission('view any unpublished content')) {
      $grants['waukee_unpublished_any'] = [0];
    }
    if ($account->isAuthenticated() && $account->hasPermission('view own unpublished content')) {
      $grants['waukee_unpublished_own'] = [(int) $account->id()];
    }
  }
  return $grants;
}

/**
 * Implements hook_node_access_records().
 */
function waukee_core_node_access_records(NodeInterface $node) {
  if ($node->isPublished()) {
    return [];
  }
  $base = ['grant_view' => 1, 'grant_update' => 0, 'grant_delete' => 0, 'langcode' => $node->language()->getId()];
  return [
    ['realm' => 'waukee_unpublished_any', 'gid' => 0] + $base,
    ['realm' => 'waukee_unpublished_own', 'gid' => (int) $node->getOwnerId()] + $base,
  ];
}
