{#
/**
 * @file
 * Job listings (/careers/jobs) in the homepage design. `jobs` comes from
 * waukee_theme_preprocess_page() (see waukee_theme.theme): the page's intro
 * text plus open and closed job postings (content type "Job posting").
 */
#}
{{ attach_library('waukee_theme/front') }}
<div class="bg-background font-body-md text-body-md text-on-surface antialiased">
{% include "@waukee_theme/includes/tw-header.html.twig" %}
<main id="main-content" class="w-full pt-20 bg-background">{% include '@waukee_theme/includes/tw-alert.html.twig' %}<div class="flex flex-col w-full">
<section class="w-full bg-surface-container-low border-b border-surface-container py-space-sm">
<div class="max-w-[1280px] mx-auto px-margin text-body-sm">
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-sm">
<a class="hover:text-primary flex items-center gap-1 transition-colors" href="/"><span class="material-symbols-outlined text-[16px]">home</span><span>Home</span></a>
<span class="text-outline-variant">/</span>
<a class="hover:text-primary transition-colors" href="/careers">Careers</a>
<span class="text-outline-variant">/</span>
<span class="text-primary font-bold">{{ jobs.title }}</span>
</nav>
</div>
</section>

<section class="relative w-full bg-primary-container text-on-primary py-space-xl overflow-hidden shadow-sm">
<div class="absolute -right-16 -top-20 w-96 h-96 bg-accent-gold-bright/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="max-w-[1280px] mx-auto px-margin relative z-10 flex flex-col gap-space-sm max-w-3xl">
<div class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-full bg-primary-fixed/20 text-secondary-fixed text-label-sm uppercase tracking-wider font-bold"><span class="material-symbols-outlined text-[15px]">work</span><span>Join Our Team</span></div>
<h1 class="font-display-hero text-headline-xl md:text-display-hero text-text-on-dark tracking-tight leading-tight">{{ jobs.title }}</h1>
{% if jobs.intro %}<div class="font-body-lg text-body-lg text-surface-container-high/90 leading-relaxed [&_a]:underline">{{ jobs.intro|raw }}</div>{% endif %}
<div class="mt-2 flex flex-wrap gap-space-sm">
<a class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-lg bg-secondary-container hover:bg-accent-gold-bright text-on-secondary-container font-label-md text-label-md font-bold transition-colors" href="/careers/benefits"><span class="material-symbols-outlined text-[18px]">health_and_safety</span><span>{{ 'Benefits'|t }}</span></a>
</div>
</div>
</section>

<section class="w-full max-w-[1280px] mx-auto px-margin py-space-xl">
<div class="mb-space-lg flex items-end justify-between flex-wrap gap-space-sm">
<div>
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold">{{ 'Now hiring'|t }}</span>
<h2 class="font-headline-lg text-headline-lg text-primary tracking-tight font-bold">{{ 'Open Positions'|t }}</h2>
</div>
<span class="px-3 py-1 rounded-full bg-accent-purple-tint text-primary font-label-md text-label-md font-bold">{{ jobs.open|length }} {{ jobs.open|length == 1 ? 'opening'|t : 'openings'|t }}</span>
</div>

{% if jobs.open %}
<div class="flex flex-col gap-space-md">
{% for job in jobs.open %}
<article class="bg-surface-base rounded-2xl p-space-lg shadow-sm border border-surface-container hover:shadow-lg transition-all flex flex-col md:flex-row md:items-center gap-space-md">
<div class="w-14 h-14 rounded-xl bg-primary-container text-accent-gold-bright flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[28px]">badge</span></div>
<div class="flex-1 flex flex-col gap-space-xs">
<h3 class="font-headline-md text-headline-md text-primary font-bold"><a class="hover:text-secondary transition-colors" href="{{ job.url }}">{{ job.title }}</a></h3>
<div class="flex flex-wrap items-center gap-x-space-md gap-y-1 font-label-md text-label-md text-on-surface-variant">
{% if job.location %}<span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-[18px] text-secondary">location_on</span>{{ job.location }}</span>{% endif %}
{% if job.closing %}<span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-[18px] text-secondary">event</span>{{ 'Closes @date'|t({'@date': job.closing}) }}</span>{% endif %}
</div>
{% if job.summary %}<p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">{{ job.summary }}</p>{% endif %}
</div>
<div class="flex flex-wrap gap-space-sm shrink-0">
<a class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md font-semibold transition-colors" href="{{ job.url }}">{{ 'View details'|t }}</a>
{% if job.apply %}<a class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-lg bg-primary hover:bg-primary-container text-text-on-dark font-label-md text-label-md font-semibold transition-colors shadow-sm" href="{{ job.apply }}" rel="noopener">{{ 'Apply'|t }}<span class="material-symbols-outlined text-[18px]">arrow_forward</span></a>{% endif %}
</div>
</article>
{% endfor %}
</div>
{% else %}
<div class="bg-surface-base rounded-2xl p-space-lg border border-surface-container text-center">
<span class="material-symbols-outlined text-[40px] text-outline">work_off</span>
<p class="font-body-md text-body-md text-on-surface-variant mt-2">{{ 'There are no open positions right now. Please check back soon.'|t }}</p>
</div>
{% endif %}

{% if jobs.closed %}
<div class="mt-space-xl">
<h2 class="font-title-md text-title-md text-on-surface-variant font-bold mb-space-sm">{{ 'Recently closed'|t }}</h2>
<ul class="flex flex-col gap-2">
{% for job in jobs.closed %}
<li class="flex flex-wrap items-center justify-between gap-2 px-space-md py-3 rounded-xl bg-surface-container-low text-on-surface-variant font-body-sm text-body-sm"><span>{{ job.title }}{% if job.location %} &middot; {{ job.location }}{% endif %}</span><span>{{ 'Closed @date'|t({'@date': job.closing}) }}</span></li>
{% endfor %}
</ul>
</div>
{% endif %}
</section>

<section class="w-full bg-surface-container-low py-space-xl border-t border-surface-container">
<div class="max-w-[1280px] mx-auto px-margin grid grid-cols-1 sm:grid-cols-3 gap-space-md">
<a class="bg-surface-base p-space-md rounded-xl border border-surface-container shadow-sm hover:shadow-md transition-all flex items-center gap-space-sm group" href="/careers/benefits"><span class="material-symbols-outlined text-accent-gold-bright text-[24px]">health_and_safety</span><span class="font-title-md text-title-md text-primary font-bold group-hover:text-secondary transition-colors">{{ 'Benefits'|t }}</span></a>
<a class="bg-surface-base p-space-md rounded-xl border border-surface-container shadow-sm hover:shadow-md transition-all flex items-center gap-space-sm group" href="/schools"><span class="material-symbols-outlined text-accent-gold-bright text-[24px]">location_city</span><span class="font-title-md text-title-md text-primary font-bold group-hover:text-secondary transition-colors">{{ 'Our Schools'|t }}</span></a>
<a class="bg-surface-base p-space-md rounded-xl border border-surface-container shadow-sm hover:shadow-md transition-all flex items-center gap-space-sm group" href="/staff-directory"><span class="material-symbols-outlined text-accent-gold-bright text-[24px]">contacts</span><span class="font-title-md text-title-md text-primary font-bold group-hover:text-secondary transition-colors">{{ 'Staff Directory'|t }}</span></a>
</div>
</section>
</div></main>
{% include "@waukee_theme/includes/tw-footer.html.twig" %}
</div>
