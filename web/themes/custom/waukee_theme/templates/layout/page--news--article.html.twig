{#
/**
 * @file
 * One news story in the homepage design. `article` comes from
 * waukee_theme_preprocess_page() (see waukee_theme.theme).
 */
#}
{{ attach_library('waukee_theme/front') }}
<div class="bg-background font-body-md text-body-md text-on-surface antialiased">
{% include "@waukee_theme/includes/tw-header.html.twig" %}
<main id="main-content" class="w-full pt-20 bg-background">{% include '@waukee_theme/includes/tw-alert.html.twig' %}<div class="flex flex-col w-full">
<section class="w-full bg-surface-container-low border-b border-surface-container py-space-sm">
<div class="max-w-[1280px] mx-auto px-margin text-body-sm">
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-sm">
<a class="hover:text-primary flex items-center gap-1 transition-colors" href="/"><span class="material-symbols-outlined text-[16px]">home</span><span>Home</span></a>
<span class="text-outline-variant">/</span>
<a class="hover:text-primary transition-colors" href="/news">News</a>
<span class="text-outline-variant">/</span>
<span class="text-primary font-bold line-clamp-1">{{ article.title }}</span>
</nav>
</div>
</section>

<section class="relative w-full bg-primary-container text-on-primary py-space-xl overflow-hidden shadow-sm">
<div class="absolute -right-16 -top-20 w-96 h-96 bg-accent-gold-bright/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="max-w-[1280px] mx-auto px-margin relative z-10 flex flex-col gap-space-sm">
<div class="flex flex-wrap items-center gap-2 font-label-sm text-label-sm">
<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-fixed/20 text-secondary-fixed uppercase tracking-wider font-bold"><span class="material-symbols-outlined text-[15px]">newspaper</span>{{ article.date }}</span>
{% for s in article.schools %}<span class="px-3 py-1 rounded-full bg-surface-base/15 text-on-primary font-semibold">{{ s }}</span>{% endfor %}
</div>
<h1 class="font-headline-xl md:text-display-hero text-text-on-dark tracking-tight leading-tight max-w-4xl font-extrabold">{{ article.title }}</h1>
</div>
</section>

<section class="w-full max-w-[1280px] mx-auto px-margin py-space-xl">
<article class="max-w-3xl mx-auto flex flex-col gap-space-lg">
{% if article.image %}
<div class="w-full h-72 md:h-96 rounded-3xl overflow-hidden shadow-xl bg-cover bg-center" style="background-image: url('{{ article.image }}')" role="img" aria-label="{{ article.title }}"></div>
{% endif %}
<div class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed [&_p]:mb-4 [&_h2]:font-headline-md [&_h2]:text-primary [&_h2]:font-bold [&_h2]:mt-6 [&_h2]:mb-2 [&_h3]:font-title-md [&_h3]:text-primary [&_h3]:font-bold [&_h3]:mt-4 [&_a]:text-primary [&_a]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-1">
{{ article.body|raw }}
</div>
<div class="pt-space-md border-t border-surface-container">
<a class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md font-semibold transition-colors" href="/news"><span class="material-symbols-outlined text-[18px]">arrow_back</span><span>{{ 'Back to all news'|t }}</span></a>
</div>
</article>
</section>
</div></main>
{% include "@waukee_theme/includes/tw-footer.html.twig" %}
</div>
