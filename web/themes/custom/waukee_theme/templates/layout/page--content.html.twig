{#
/**
 * @file
 * Inner page inside an audience section (for example /students/activities,
 * /community/board-of-education) in the homepage design. `content_page` comes
 * from waukee_theme_preprocess_page() (see waukee_theme.theme): the page's
 * title and body, its section, and the other pages of that section.
 */
#}
{{ attach_library('waukee_theme/front') }}
<div class="bg-background font-body-md text-body-md text-on-surface antialiased">
{% include "@waukee_theme/includes/tw-header.html.twig" %}
<main id="main-content" class="w-full pt-20 bg-background">{% include '@waukee_theme/includes/tw-alert.html.twig' %}<div class="flex flex-col w-full">
<section class="w-full bg-surface-container-low border-b border-surface-container py-space-sm">
<div class="max-w-[1280px] mx-auto px-margin text-body-sm">
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-sm">
<a class="hover:text-primary flex items-center gap-1 transition-colors" href="/"><span class="material-symbols-outlined text-[16px]">home</span><span>Home</span></a>
<span class="text-outline-variant">/</span>
<a class="hover:text-primary transition-colors" href="{{ content_page.parent_url }}">{{ content_page.parent_title }}</a>
<span class="text-outline-variant">/</span>
<span class="text-primary font-bold line-clamp-1">{{ content_page.title }}</span>
</nav>
</div>
</section>

<section class="relative w-full bg-primary-container text-on-primary py-space-xl overflow-hidden shadow-sm">
<div class="absolute -right-16 -top-20 w-96 h-96 bg-accent-gold-bright/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="max-w-[1280px] mx-auto px-margin relative z-10 flex flex-col gap-space-sm max-w-3xl">
<div class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-full bg-primary-fixed/20 text-secondary-fixed text-label-sm uppercase tracking-wider font-bold"><span class="material-symbols-outlined text-[15px]">{{ content_page.icon }}</span><span>{{ content_page.eyebrow }}</span></div>
<h1 class="font-display-hero text-headline-xl md:text-display-hero text-text-on-dark tracking-tight leading-tight">{{ content_page.title }}</h1>
</div>
</section>

<section class="w-full max-w-[1280px] mx-auto px-margin py-space-xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl">
<article class="lg:col-span-8 bg-surface-base rounded-2xl p-space-lg shadow-sm border border-surface-container">
{% if content_page.body %}
<div class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed [&_p]:mb-4 [&_h2]:font-headline-md [&_h2]:text-primary [&_h2]:font-bold [&_h2]:mt-6 [&_h2]:mb-2 [&_h3]:font-title-md [&_h3]:text-primary [&_h3]:font-bold [&_h3]:mt-4 [&_a]:text-primary [&_a]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-1 [&_table]:w-full [&_td]:border [&_td]:p-2 [&_th]:border [&_th]:p-2">{{ content_page.body|raw }}</div>
{% else %}
{{ page.content }}
{% endif %}
<p class="mt-space-lg pt-space-sm border-t border-surface-container font-label-sm text-label-sm text-on-surface-variant">{{ 'Last updated @date'|t({'@date': content_page.updated}) }}</p>
</article>

<aside class="lg:col-span-4 flex flex-col gap-space-md">
<nav aria-label="{{ 'In this section'|t }}" class="bg-surface-base rounded-2xl p-space-md shadow-sm border border-surface-container lg:sticky lg:top-32">
<h2 class="font-title-md text-title-md text-primary font-bold mb-space-xs px-2">{{ 'In this section'|t }}</h2>
<ul class="flex flex-col gap-1">
{% for item in content_page.siblings %}
<li><a href="{{ item.url }}" class="flex items-center gap-space-sm px-3 py-2.5 rounded-lg font-label-md text-label-md transition-colors {{ item.current ? 'bg-primary text-text-on-dark font-bold' : 'text-primary hover:bg-accent-purple-tint font-semibold' }}"{% if item.current %} aria-current="page"{% endif %}><span class="material-symbols-outlined text-[20px] {{ item.current ? 'text-accent-gold-bright' : 'text-secondary' }}">{{ item.icon }}</span><span>{{ item.title }}</span></a></li>
{% endfor %}
</ul>
<a class="mt-space-sm inline-flex items-center gap-1 px-2 font-label-md text-label-md text-primary font-bold hover:text-secondary transition-colors" href="{{ content_page.parent_url }}"><span class="material-symbols-outlined text-[18px]">arrow_back</span>{{ 'Back to @section'|t({'@section': content_page.parent_title}) }}</a>
</nav>
</aside>
</div>
</section>
</div></main>
{% include "@waukee_theme/includes/tw-footer.html.twig" %}
</div>
