{#
/**
 * @file
 * Waukee page template. Own markup (no Olivero header/layout wrappers):
 * alert region, sticky header with audience navigation, quick links bar,
 * main content (optional sidebar), footer.
 *
 * Regions: alert, header, primary_menu, secondary_menu, quick_links, hero,
 * highlighted, breadcrumb, content_above, content, content_below, sidebar,
 * footer_top, footer_bottom.
 */
#}
<div class="wk-page">

  {% if page.alert %}
    <div class="alert-region" role="region" aria-label="{{ 'Site alerts'|t }}">
      {{ page.alert }}
    </div>
  {% endif %}

  {% if page.secondary_menu %}
    <div class="wk-utility-bar">
      <div class="wk-container wk-utility-bar__inner">
        <span class="wk-utility-bar__tagline">{{ 'Waukee Community School District'|t }}</span>
        <div class="wk-utility-bar__menu">{{ page.secondary_menu }}</div>
      </div>
    </div>
  {% endif %}

  <header class="wk-header" data-wk-header>
    <div class="wk-container wk-header__inner">
      <div class="wk-header__brand">
        {{ page.header }}
      </div>

      <div class="wk-header__right">
        <div id="wk-nav" class="wk-header__nav">
          <div class="wk-header__primary">{{ page.primary_menu }}</div>
          <a href="/enrollment" class="wk-header__enroll">{{ 'Enroll Now'|t }}</a>
        </div>

        <button type="button" class="wk-header__toggle" aria-expanded="false" aria-controls="wk-nav">
          <span class="wk-header__toggle-label">{{ 'Menu'|t }}</span>
          <span class="wk-header__toggle-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content" class="wk-main" tabindex="-1">
    {{ page.hero }}
    {% if page.quick_links %}
      <div class="wk-quickbar{% if page.hero %} wk-quickbar--floating{% endif %}">
        <div class="wk-container">
          {{ page.quick_links }}
        </div>
      </div>
    {% endif %}
    <div class="wk-container wk-main__inner{% if page.sidebar %} wk-main__inner--sidebar{% endif %}">
      {% if page.highlighted or page.breadcrumb %}
        <div class="wk-main__top">
          {{ page.highlighted }}
          {{ page.breadcrumb }}
        </div>
      {% endif %}
      <div class="wk-main__content">
        {{ page.content_above }}
        {{ page.content }}
        {{ page.content_below }}
      </div>
      {% if page.sidebar %}
        <aside class="wk-sidebar" aria-label="{{ 'Sidebar'|t }}">
          {{ page.sidebar }}
        </aside>
      {% endif %}
    </div>
  </main>

  <footer class="wk-footer">
    <div class="wk-container">
      {% if page.footer_top %}
        <div class="wk-footer__grid">
          {{ page.footer_top }}
        </div>
      {% endif %}
      <div class="wk-footer__bottom">
        <p class="wk-footer__legal">&copy; {{ 'now'|date('Y') }} {{ 'Sample Community Schools. Prototype with sample content only.'|t }}</p>
        {{ page.footer_bottom }}
      </div>
    </div>
  </footer>

</div>
