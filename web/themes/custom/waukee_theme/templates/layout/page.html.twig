{#
/**
 * @file
 * Waukee inner page template. Own markup (no Olivero header/layout wrappers):
 * alert region, the shared site header (includes/tw-header.html.twig, the same
 * header as the home page), a logged-in account bar, main content (optional
 * sidebar) and the shared footer (includes/tw-footer.html.twig).
 *
 * The header and footer are Tailwind markup; css/tw-chrome.css (library
 * "chrome") styles them here and is scoped to .wk-chrome so it cannot affect
 * page content.
 *
 * Regions: alert, hero, highlighted, breadcrumb, content_above, content,
 * content_below, sidebar. (header, menus and footer regions are no longer
 * rendered: header and footer are the shared partials.)
 */
#}
{{ attach_library('waukee_theme/chrome') }}
<div class="wk-page wk-chrome">

  {% if page.alert %}
    <div class="alert-region" role="region" aria-label="{{ 'Site alerts'|t }}">
      {{ page.alert }}
    </div>
  {% endif %}

  {% include '@waukee_theme/includes/tw-header.html.twig' with {wk_sticky: true} %}
  {% include '@waukee_theme/includes/account-bar.html.twig' %}

  <main id="main-content" class="wk-main" tabindex="-1">
    {{ page.hero }}
    <div class="wk-container wk-main__inner{% if page.sidebar %} wk-main__inner--sidebar{% endif %}">
      {% if page.highlighted or page.breadcrumb %}
        <div class="wk-main__top">
          {{ page.highlighted }}
          {{ page.breadcrumb }}
        </div>
      {% endif %}
      <div class="wk-main__content">
        {{ page.content_above }}
        {{ page.content }}
        {{ page.content_below }}
      </div>
      {% if page.sidebar %}
        <aside class="wk-sidebar" aria-label="{{ 'Sidebar'|t }}">
          {{ page.sidebar }}
        </aside>
      {% endif %}
    </div>
  </main>

  {% include '@waukee_theme/includes/tw-footer.html.twig' %}

</div>
