{#
/**
 * @file
 * One school's page (/schools/{school}), for every school in the directory.
 * `school` comes from waukee_theme_preprocess_page() (see waukee_theme.theme),
 * which reads it from the "school" group entity matching the slug in the URL
 * (see scripts/phase17_schools_data.php). Sections below "Campus Overview"
 * only render when `school.full_profile` is on for that school (currently
 * only Waukee High School).
 */
#}
{% if not school %}
  <p>{{ 'School not found.'|t }}</p>
{% else %}
{{ attach_library('waukee_theme/front') }}
<div class="bg-background font-body-md text-body-md text-on-surface antialiased">
{% include "@waukee_theme/includes/tw-header.html.twig" %}
<main id="main-content" class="w-full pt-20 bg-background"><div class="flex flex-col w-full">
<!-- Top District Breadcrumb Bar -->
<section class="w-full bg-surface-container-low border-b-0 py-space-sm">
<div class="max-w-[1280px] mx-auto px-margin flex items-center justify-between text-body-sm">
<nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-sm">
<a class="hover:text-primary transition-colors flex items-center gap-1" href="/">
<span class="material-symbols-outlined text-[16px]">home</span>
          Home
        </a>
<span class="opacity-40">/</span>
<a class="hover:text-primary transition-colors" href="/schools">Schools</a>
<span class="opacity-40">/</span>
<span class="text-primary font-bold">{{ school.name }}</span>
</nav>
</div>
</section>
<!-- Hero & School Identity Overview -->
<section class="w-full bg-surface relative overflow-hidden py-space-xl">
<div class="max-w-[1280px] mx-auto px-margin">
<div class="flex flex-wrap items-center justify-between gap-space-md mb-space-lg">
<div class="flex flex-wrap items-center gap-space-xs">
{% if school.grades %}
<span class="px-space-md py-1.5 rounded-full bg-primary-container text-on-primary font-label-sm tracking-wide shadow-sm flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-accent-gold-bright">school</span>
            Grades {{ school.grades }}
          </span>
{% endif %}
{% if school.feeder %}
<span class="px-space-md py-1.5 rounded-full bg-accent-purple-tint text-primary font-label-sm font-semibold">
            {{ school.feeder == 'waukee' ? 'Waukee High Feeder Zone' : (school.feeder == 'northwest' ? 'Northwest Feeder Zone' : 'District-Wide') }}
          </span>
{% endif %}
{% if school.badge %}
<span class="px-space-md py-1.5 rounded-full bg-secondary-container text-on-secondary-container font-label-sm font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">sports_martial_arts</span>
            {{ school.badge }}
          </span>
{% endif %}
</div>
{% if school.website %}
<div class="flex items-center gap-space-xs">
<a class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-primary font-label-sm font-bold transition-all flex items-center gap-1.5" href="{{ school.website }}" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[16px]">military_tech</span>
            {{ school.mascot ? school.mascot ~ ' Athletics' : 'Visit Website' }}
          </a>
</div>
{% endif %}
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
<div class="lg:col-span-7 flex flex-col relative rounded-xl overflow-hidden shadow-md group">
{% if school.image %}
<div class="relative w-full h-[360px] lg:h-[440px] bg-cover bg-center overflow-hidden" role="img" aria-label="{{ school.name }} campus" style="background-image: url('{{ school.image }}')">
{% else %}
<div class="relative w-full h-[360px] lg:h-[440px] bg-cover bg-center overflow-hidden flex items-center justify-center bg-gradient-to-br from-primary-container to-primary">
<span class="material-symbols-outlined text-on-primary/30 text-[140px]">school</span>
{% endif %}
<div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/30 to-transparent"></div>
<div class="absolute bottom-space-lg left-space-lg right-space-lg text-on-primary">
{% if school.hero_tagline %}
<div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-2.5 py-1 rounded-md font-label-sm uppercase font-bold tracking-wider mb-2">
                {{ school.hero_tagline }}
              </div>
{% endif %}
<h1 class="font-display-hero text-display-hero-mobile sm:text-headline-xl text-on-primary font-extrabold tracking-tight">
                {{ school.name }}
              </h1>
{% if school.summary %}
<p class="font-body-md text-body-md text-surface-container-high mt-1 max-w-xl">
                {{ school.summary }}
              </p>
{% endif %}
</div>
</div>
</div>
<div class="lg:col-span-5 flex flex-col justify-between bg-surface-container-lowest p-space-lg rounded-xl shadow-sm">
<div>
<div class="flex items-center justify-between pb-space-md">
<div class="flex items-center gap-2">
<div class="w-8 h-8 rounded-lg bg-accent-purple-tint flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[20px]">pin_drop</span>
</div>
<div>
<h2 class="font-title-md text-title-md text-primary font-bold">Campus Overview</h2>
{% if school.address %}<p class="font-label-sm text-text-muted">{{ school.address }}</p>{% endif %}
</div>
</div>
{% if school.csd_unit %}<span class="px-2.5 py-1 rounded-md bg-accent-lime-tint text-on-tertiary-fixed font-label-sm font-bold">{{ school.csd_unit }}</span>{% endif %}
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm pt-space-xs mb-space-md">
{% if school.phone %}
<div class="p-space-sm bg-surface-container-low rounded-lg">
<span class="font-label-sm text-text-muted uppercase tracking-wider block">Main Office</span>
<a class="font-title-md text-primary font-bold hover:underline flex items-center gap-1 mt-0.5" href="tel:{{ school.phone }}">
<span class="material-symbols-outlined text-[18px]">call</span>
                  {{ school.phone }}
                </a>
</div>
{% endif %}
{% if school.attendance_phone %}
<div class="p-space-sm bg-accent-purple-tint rounded-lg">
<span class="font-label-sm text-primary uppercase tracking-wider font-semibold block">Attendance Line</span>
<a class="font-title-md text-primary font-bold hover:underline flex items-center gap-1 mt-0.5" href="tel:{{ school.attendance_phone }}">
<span class="material-symbols-outlined text-[18px]">event_available</span>
                  {{ school.attendance_phone }}
                </a>
</div>
{% endif %}
{% if school.bell_hours %}
<div class="p-space-sm bg-surface-container-low rounded-lg">
<span class="font-label-sm text-text-muted uppercase tracking-wider block">Daily Bell Hours</span>
<p class="font-label-md text-on-surface font-semibold mt-0.5">{{ school.bell_hours }}</p>
{% if school.early_dismissal %}<span class="font-label-sm text-text-muted">Early Dismissal: {{ school.early_dismissal }}</span>{% endif %}
</div>
{% endif %}
{% if school.principal %}
<div class="p-space-sm bg-surface-container-low rounded-lg min-w-0">
<span class="font-label-sm text-text-muted uppercase tracking-wider block">Principal</span>
<p class="font-label-md text-on-surface font-semibold mt-0.5">{{ school.principal }}</p>
{% if school.principal_email %}<a class="block min-w-0 break-words font-label-sm text-secondary font-bold hover:underline" href="mailto:{{ school.principal_email }}">{% set email_parts = school.principal_email|split('@', 2) %}{% if email_parts|length == 2 %}{{ email_parts[0] }}@<wbr>{{ email_parts[1] }}{% else %}{{ school.principal_email }}{% endif %}</a>{% endif %}
</div>
{% endif %}
</div>
</div>
<div class="flex flex-col gap-space-xs pt-space-xs">
<span class="font-label-sm text-text-muted uppercase tracking-wider">Fast Access Actions</span>
<div class="grid grid-cols-2 gap-space-xs">
{% if school.attendance_phone %}
<a class="inline-flex items-center justify-center gap-2 bg-primary text-on-primary font-label-md py-3 px-space-sm rounded-lg hover:bg-primary-container transition-all shadow-sm" href="tel:{{ school.attendance_phone }}">
<span class="material-symbols-outlined text-[18px]">notifications_active</span>
                Report Absence
              </a>
{% endif %}
<a class="inline-flex items-center justify-center gap-2 bg-secondary-container text-on-secondary-container font-label-md font-bold py-3 px-space-sm rounded-lg hover:bg-accent-gold-bright transition-all shadow-sm" href="#">
<span class="material-symbols-outlined text-[18px]">account_circle</span>
                PowerSchool
              </a>
{% if school.full_profile %}
<a class="inline-flex items-center justify-center gap-2 bg-surface-container hover:bg-surface-variant text-primary font-label-md font-semibold py-2.5 px-space-sm rounded-lg transition-all" href="#schedules-section">
<span class="material-symbols-outlined text-[18px]">schedule</span>
                Bell Schedules
              </a>
{% endif %}
</div>
</div>
</div>
</div>
</div>
</section>
{% if school.full_profile %}
<!-- Quick Links Grid: Official School Resources -->
<section class="w-full bg-surface-container-low py-space-xl">
<div class="max-w-[1280px] mx-auto px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg">
<div>
<span class="font-label-sm uppercase tracking-widest text-secondary font-bold">Essential Information</span>
<h2 class="font-headline-lg text-headline-lg text-primary tracking-tight font-bold">{{ school.name }} Resource Directory</h2>
<p class="font-body-md text-on-surface-variant mt-1">Direct navigation to vital student programs, logistics, policies, and family guides.</p>
</div>
</div>
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-space-md">
{% set resources = [
  {title: 'Activities & Clubs', text: 'Sports, clubs, student senate, and fine arts schedules.', icon: 'sports_soccer', href: school.website ?: '#', external: school.website ? true : false},
  {title: 'Bus Transportation', text: 'District routes, shuttle pick-up spots, and live bus tracker apps.', icon: 'directions_bus', href: '/transportation'},
  {title: 'School Calendar', text: 'Upcoming terms, conferences, breaks, and athletic matches.', icon: 'calendar_month', href: '/calendar'},
  {title: 'Closings & Delays', text: 'Severe weather safety notices, late starts, and alert signups.', icon: 'weather_snowy', href: '/closings'},
  {title: 'Student Handbook', text: 'Rights, code of conduct, grading scales, and school safety guidelines.', icon: 'menu_book', href: '#'},
  {title: 'Lunch Menus & Treats', text: 'Weekly cafeteria menus, dietary accommodations, and account prepay.', icon: 'restaurant_menu', href: '/lunch-menus'},
  {title: 'Silver Cord Volunteering', text: 'Track civic service hours toward graduation honors cord recognition.', icon: 'volunteer_activism', href: '/students/volunteer-hours', highlight: true},
  {title: 'Course Descriptions', text: 'Curriculum catalog, AP subjects, concurrent college credit, and electives.', icon: 'history_edu', href: '#'},
  {title: 'Parking & Permits', text: 'Semester vehicle registration, parking stickers, and campus traffic maps.', icon: 'local_parking', href: '#'},
  {title: 'Transcript Requests', text: 'Official transcript dispatch for university and employer portals.', icon: 'description', href: '#'},
  {title: 'Supply List', text: 'General classroom supplies and 1:1 digital accessories.', icon: 'inventory_2', href: '#'},
] %}
{% for r in resources %}
<a class="group p-space-md rounded-xl bg-surface-container-lowest hover:bg-accent-purple-tint transition-all duration-200 shadow-sm hover:shadow-md flex flex-col justify-between" href="{{ r.href }}"{% if r.external %} rel="noopener noreferrer" target="_blank"{% endif %}>
<div class="flex items-center justify-between mb-space-sm">
{% if r.highlight %}
<div class="w-10 h-10 rounded-lg bg-secondary-container text-on-secondary-container flex items-center justify-center">
{% else %}
<div class="w-10 h-10 rounded-lg bg-surface-container group-hover:bg-primary-container text-primary group-hover:text-accent-gold-bright flex items-center justify-center transition-colors">
{% endif %}
<span class="material-symbols-outlined text-[24px]">{{ r.icon }}</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-transform group-hover:translate-x-1">arrow_forward</span>
</div>
<div>
<h3 class="font-title-md text-title-md text-primary font-bold">{{ r.title }}</h3>
<p class="font-body-sm text-on-surface-variant mt-1">{{ r.text }}</p>
</div>
</a>
{% endfor %}
<div class="p-space-md rounded-xl bg-primary-container text-on-primary flex flex-col justify-between shadow-sm">
<div>
<span class="font-label-sm text-accent-gold-bright uppercase tracking-wider font-bold">Need Guidance?</span>
<h3 class="font-title-md text-title-md font-bold mt-1">Counseling Office</h3>
<p class="font-body-sm text-on-primary-container mt-1">Academic advising, college prep, and mental wellness resources.</p>
</div>
{% if school.phone %}
<a class="mt-space-sm text-on-primary font-label-md font-bold underline flex items-center gap-1 hover:text-accent-gold-bright transition-colors" href="tel:{{ school.phone }}">
            Connect With Counselors
            <span class="material-symbols-outlined text-[16px]">north_east</span>
</a>
{% endif %}
</div>
</div>
</div>
</section>
{% if school.principal_message %}
<!-- Principal Message & Administrative Team Grid -->
<section class="w-full bg-surface py-space-xl">
<div class="max-w-[1280px] mx-auto px-margin">
<div class="bg-surface-container-lowest rounded-xl shadow-md p-space-lg lg:p-space-xl mb-space-xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
<div class="lg:col-span-4 flex flex-col items-center text-center">
<h3 class="font-headline-sm text-headline-sm text-primary font-bold">{{ school.principal }}</h3>
<span class="px-3 py-1 rounded-full bg-accent-purple-tint text-primary font-label-sm font-semibold mt-1">Principal, {{ school.name }}</span>
{% if school.principal_email %}
<a class="font-label-md text-secondary font-bold hover:underline mt-2 flex flex-wrap items-center justify-center gap-1 max-w-full min-w-0 [overflow-wrap:anywhere]" href="mailto:{{ school.principal_email }}">
<span class="material-symbols-outlined text-[16px]">mail</span>
              {% set email_parts = school.principal_email|split('@', 2) %}{% if email_parts|length == 2 %}{{ email_parts[0] }}@<wbr>{{ email_parts[1] }}{% else %}{{ school.principal_email }}{% endif %}
            </a>
{% endif %}
</div>
<div class="lg:col-span-8">
<div class="flex items-center gap-2 mb-space-xs text-secondary font-bold">
<span class="material-symbols-outlined text-[20px]">campaign</span>
<span class="font-label-sm uppercase tracking-wider">Leadership Message</span>
</div>
<div class="space-y-3 font-body-md text-on-surface-variant leading-relaxed">
          {{ school.principal_message.value|raw }}
        </div>
</div>
</div>
</div>
{% if school.leadership_team %}
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg">
<div>
<span class="font-label-sm uppercase tracking-widest text-secondary font-bold">Administration &amp; Support</span>
<h2 class="font-headline-lg text-headline-lg text-primary tracking-tight font-bold">Administrative Leadership Team</h2>
</div>
</div>
<div class="prose max-w-none font-body-sm text-on-surface-variant">
      {{ school.leadership_team.value|raw }}
    </div>
{% endif %}
</div>
</section>
{% endif %}
<!-- Bell Times & Schedules -->
<section class="w-full bg-surface-container-low py-space-xl scroll-mt-28" id="schedules-section">
<div class="max-w-[1280px] mx-auto px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg">
<div>
<span class="font-label-sm uppercase tracking-widest text-secondary font-bold">Time Management</span>
<h2 class="font-headline-lg text-headline-lg text-primary tracking-tight font-bold">Class &amp; Lunch Schedules</h2>
<p class="font-body-md text-on-surface-variant mt-1">Review standard instructional block rotations and staggered lunch shifts.</p>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg" id="schedule-regular">
<div class="lg:col-span-7 bg-surface-container-lowest p-space-lg rounded-xl shadow-sm">
<div class="flex items-center justify-between pb-space-sm mb-space-sm border-b-0">
<span class="font-title-md text-title-md text-primary font-bold">Standard 4-Block Daily Sequence</span>
<span class="px-2.5 py-1 rounded bg-accent-purple-tint text-primary font-label-sm font-bold">4 Blocks • 90 Mins Each</span>
</div>
<div class="space-y-space-sm">
{% for b in [
  {n: 1, label: 'Block 1', text: 'Morning core instruction & studio classes', time: '7:50 AM – 9:24 AM', mins: '94 Minutes', highlight: false},
  {n: 2, label: 'Block 2', text: 'Mid-morning academics', time: '9:30 AM – 11:04 AM', mins: '94 Minutes', highlight: false},
  {n: 3, label: 'Block 3 & Lunch Waves', text: 'Extended period integrated with A, B, or C Lunch', time: '11:10 AM – 1:10 PM', mins: '120 Minutes Total', highlight: true},
  {n: 4, label: 'Block 4', text: 'Afternoon courses, labs, and dismissal prep', time: '1:16 PM – 2:50 PM', mins: '94 Minutes', highlight: false},
] %}
<div class="flex items-center justify-between p-space-sm rounded-lg {{ b.highlight ? 'bg-accent-purple-tint' : 'bg-surface-container-low hover:bg-surface-container transition-colors' }}">
<div class="flex items-center gap-3">
<span class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center font-bold text-label-md">{{ b.n }}</span>
<div>
<h4 class="font-title-md {{ b.highlight ? 'text-primary' : 'text-on-surface' }} font-bold">{{ b.label }}</h4>
<p class="font-body-sm {{ b.highlight ? 'text-primary/80' : 'text-text-muted' }}">{{ b.text }}</p>
</div>
</div>
<div class="text-right">
<span class="font-title-md text-primary font-bold">{{ b.time }}</span>
<span class="block font-label-sm {{ b.highlight ? 'text-primary font-medium' : 'text-text-muted' }}">{{ b.mins }}</span>
</div>
</div>
{% endfor %}
</div>
</div>
<div class="lg:col-span-5 bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">
<div>
<div class="flex items-center justify-between pb-space-sm mb-space-sm">
<span class="font-title-md text-title-md text-primary font-bold">Regular Lunch Rotations</span>
<span class="material-symbols-outlined text-secondary">lunch_dining</span>
</div>
<p class="font-body-sm text-on-surface-variant mb-space-md">
                Lunch schedules are assigned by department. Students eat before, during, or after their 3rd block class.
              </p>
<div class="space-y-space-sm">
{% for l in [
  {name: 'A Lunch', time: '11:04 AM – 11:34 AM', note: 'Class Block 3 meets: 11:38 AM – 1:10 PM'},
  {name: 'B Lunch', time: '11:55 AM – 12:25 PM', note: 'Class meets: 11:10–11:55 AM & 12:27–1:10 PM'},
  {name: 'C Lunch', time: '12:40 PM – 1:10 PM', note: 'Class Block 3 meets: 11:10 AM – 12:40 PM'},
] %}
<div class="p-space-sm rounded-lg bg-surface-container-low">
<div class="flex items-center justify-between">
<span class="font-label-md font-bold text-primary">{{ l.name }}</span>
<span class="font-label-md font-bold text-primary">{{ l.time }}</span>
</div>
<p class="font-label-sm text-text-muted mt-1">{{ l.note }}</p>
</div>
{% endfor %}
</div>
</div>
<div class="mt-space-md pt-space-sm bg-accent-lime-tint p-3 rounded-lg flex items-center gap-2 text-on-tertiary-fixed font-label-sm">
<span class="material-symbols-outlined text-[20px] text-primary">info</span>
<span>All students must remain on campus during designated lunch shifts unless participating in senior open privilege.</span>
</div>
</div>
</div>
</div>
</section>
{% if school.news_highlights %}
<!-- News & Highlights -->
<section class="w-full bg-surface py-space-xl">
<div class="max-w-[1280px] mx-auto px-margin">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg">
<div>
<span class="font-label-sm uppercase tracking-widest text-secondary font-bold">Campus Stories</span>
<h2 class="font-headline-lg text-headline-lg text-primary tracking-tight font-bold">{{ school.name }} News &amp; Highlights</h2>
</div>
<a class="mt-4 md:mt-0 inline-flex items-center gap-1.5 font-label-md font-bold text-primary hover:text-secondary transition-colors" href="/community/news">
          View All District Stories
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
<div class="prose max-w-none font-body-sm text-on-surface-variant">
      {{ school.news_highlights.value|raw }}
    </div>
</div>
</section>
{% endif %}
{% if school.family_resources %}
<!-- Family Resources & Get Involved -->
<section class="w-full bg-surface-container-low py-space-xl">
<div class="max-w-[1280px] mx-auto px-margin grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
<div class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-sm p-space-lg lg:p-space-xl flex flex-col justify-between">
<div>
<div class="flex items-center gap-2 text-secondary font-bold">
<span class="material-symbols-outlined text-[18px]">family_restroom</span>
<span class="font-label-sm uppercase tracking-wider">Parent &amp; Guardian Support</span>
</div>
<h2 class="font-headline-lg text-headline-lg text-primary font-bold tracking-tight mt-1">Family Resources</h2>
<div class="prose max-w-none font-body-sm text-on-surface-variant mt-space-md">
          {{ school.family_resources.value|raw }}
        </div>
</div>
<div class="mt-space-lg flex flex-wrap items-center gap-space-md">
<a class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md px-space-lg py-3 rounded-lg shadow-sm transition-all" href="/families">
            Check Out Family Resources <span class="material-symbols-outlined text-[18px]">open_in_new</span>
</a>
</div>
</div>
<div class="lg:col-span-5 rounded-xl shadow-md p-space-lg lg:p-space-xl bg-gradient-to-br from-primary-container to-primary text-on-primary flex flex-col justify-between">
<div>
<span class="inline-block px-3 py-1 rounded-md bg-secondary-container text-on-secondary-container font-label-sm font-bold uppercase tracking-wider">Community Engagement</span>
<h2 class="font-headline-lg text-headline-lg text-on-primary font-bold tracking-tight mt-space-sm">Get Involved</h2>
<p class="font-body-sm text-body-sm text-on-primary/80 mt-2">Join us in shaping the educational environment. Discover career opportunities, adult education classes, and community volunteer openings across Waukee schools.</p>
<div class="mt-space-md space-y-space-sm">
{% for g in [
  {title: 'Careers at Waukee', text: 'Teaching, coaching & support positions', icon: 'work', href: '/careers', badge: 'bg-secondary-container text-on-secondary-container'},
  {title: 'Community Education', text: 'Youth clinics, adult fitness & enrichment', icon: 'local_library', href: '/community', badge: 'bg-surface-base text-primary'},
] %}
<a class="flex items-center gap-3 p-space-sm rounded-lg bg-surface-base/10 hover:bg-surface-base/20 transition-colors" href="{{ g.href }}">
<span class="w-10 h-10 rounded-lg {{ g.badge }} flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[20px]">{{ g.icon }}</span></span>
<span class="flex-1">
<span class="block font-label-md text-label-md font-bold text-on-primary">{{ g.title }}</span>
<span class="block font-label-sm text-label-sm text-on-primary/70">{{ g.text }}</span>
</span>
