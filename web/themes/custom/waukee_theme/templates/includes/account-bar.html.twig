{#
/**
 * @file
 * Logged-in account bar: who is signed in plus the actions that person may
 * use (Add page, Add news, Content, Scheduled, intranet, Log out). Built in
 * waukee_theme_account_links(); shown only when there are links.
 */
#}
{% if wk_account_links %}
  <div class="wk-sh__account">
    <div class="wk-sh__wrap wk-sh__account-inner">
      <span class="wk-sh__account-name">{{ 'Signed in as'|t }} <strong>{{ wk_account_name }}</strong></span>
      <nav class="wk-sh__account-links" aria-label="{{ 'Account and editing'|t }}">
        {% for link in wk_account_links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
        <a href="{{ wk_logout_url }}">{{ 'Log out'|t }}</a>
      </nav>
    </div>
  </div>
{% endif %}
